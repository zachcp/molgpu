{
  // Shared compiler settings for @molgpu TypeScript source. The flags mirror what
  // JSR and Node's type stripping require:
  // - isolatedDeclarations: every export carries an explicit type (JSR's "no slow types").
  // - erasableSyntaxOnly: no enums/namespaces/parameter properties, so Node can strip types.
  // - verbatimModuleSyntax: type-only imports are written as such and erased verbatim.
  // - allowImportingTsExtensions + noEmit: source imports end in .ts, as Deno and JSR expect.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@webgpu/types"]
  }
}
