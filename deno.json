{
  "workspace": [
    "./packages/table",
    "./packages/geo",
    "./packages/timeline",
    "./packages/select",
    "./packages/fields",
    "./packages/io",
    "./packages/viewer"
  ],
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable", "deno.ns"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@use-gpu/core": "npm:@use-gpu/core@0.20.0",
    "@use-gpu/core/": "npm:/@use-gpu/core@0.20.0/",
    "@use-gpu/live": "npm:@use-gpu/live@0.20.0",
    "@use-gpu/live/": "npm:/@use-gpu/live@0.20.0/",
    "@use-gpu/shader": "npm:@use-gpu/shader@0.20.0",
    "@use-gpu/shader/": "npm:/@use-gpu/shader@0.20.0/",
    "@use-gpu/webgpu": "npm:@use-gpu/webgpu@0.20.0",
    "@use-gpu/webgpu/": "npm:/@use-gpu/webgpu@0.20.0/",
    "@use-gpu/wgsl": "npm:@use-gpu/wgsl@0.20.0",
    "@use-gpu/wgsl/": "npm:/@use-gpu/wgsl@0.20.0/",
    "@use-gpu/workbench": "npm:@use-gpu/workbench@0.20.0",
    "@use-gpu/workbench/": "npm:/@use-gpu/workbench@0.20.0/",
    "@use-gpu/glyph": "npm:@use-gpu/glyph@0.20.0",
    "@use-gpu/glyph/": "npm:/@use-gpu/glyph@0.20.0/",
    "@webgpu/types": "npm:@webgpu/types@0.1.68",
    "molstar": "npm:molstar@5.11.0",
    "molstar/": "npm:/molstar@5.11.0/",
    "playwright": "npm:playwright@1.62.1",
    "react": "npm:react@19.3.0",
    "react-dom/client": "npm:react-dom@19.3.0/client",
    "typescript": "npm:typescript@5.9.3",
    "vite": "npm:vite@8.3.0"
  },
  "tasks": {
    "fmt": "deno fmt --check",
    "test": "deno test -A packages/*/test/*.test.ts test/selection/*.test.ts",
    "check:hardening": "deno run -A scripts/check-hardening.mjs",
    "jsr:check": "deno publish --dry-run --allow-dirty",
    "typecheck": "deno check packages/*/src/index.ts packages/*/test/*.test.ts test/selection/*.test.ts",
    "typecheck:components": "deno check packages/viewer/test/tsx/consumer.tsx packages/viewer/test/tsx/diagnostics.ts",
    "typecheck:site": "deno check site/src/main.tsx",
    "build:site": "deno run -A npm:vite@8.3.0 build --config site/vite.config.mjs",
    "dev:site": "deno run -A npm:vite@8.3.0 --config site/vite.config.mjs",
    "test:corpus": "deno test -A packages/io/test/corpus.test.ts",
    "test:fields:gpu": "deno test -A packages/fields/test/run-browser.mjs",
    "test:gpu": "deno test -A packages/viewer/test/run-browser.mjs",
    "test:viewer:sizefield": "deno test -A packages/viewer/test/run-size-field.mjs",
    "test:viewer:gate2": "deno test -A packages/viewer/test/run-gate2.mjs",
    "test:viewer:tube": "deno test -A packages/viewer/test/run-tube.mjs",
    "test:viewer:surface": "deno test -A packages/viewer/test/run-surface.mjs",
    "test:viewer:ribbon": "deno test -A packages/viewer/test/run-ribbon.mjs",
    "test:viewer:materials": "deno test -A packages/viewer/test/run-materials.mjs",
    "test:viewer:postprocess": "deno test -A packages/viewer/test/run-postprocess.mjs",
    "test:viewer:picking": "deno test -A packages/viewer/test/run-picking.mjs",
    "test:viewer:annotations": "deno test -A packages/viewer/test/run-annotations.mjs",
    "test:viewer:invalidation": "deno test -A packages/viewer/test/run-invalidation.mjs",
    "test:components": "deno test -A packages/viewer/test/run-components.mjs",
    "test:site": "deno test -A site/test/run-browser.mjs"
  }
}
