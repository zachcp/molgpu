#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

run_step() {
  local label="$1"
  shift
  local started=$SECONDS
  printf '\n==> %s\n' "$label"
  "$@"
  printf '<== %s (%ss)\n' "$label" "$((SECONDS - started))"
}

profile_marker="# molgpu orb tools"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# molgpu orb tools
export DENO_INSTALL="$HOME/.deno"
case ":$PATH:" in
  *":$DENO_INSTALL/bin:"*) ;;
  *) export PATH="$DENO_INSTALL/bin:$PATH" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
EOF
fi

export DENO_INSTALL="$HOME/.deno"
export PATH="$DENO_INSTALL/bin:$HOME/.local/bin:$PATH"

if ! command -v deno >/dev/null 2>&1; then
  run_step "Install Deno 2" bash -c \
    'curl -fsSL https://deno.land/install.sh | sh'
fi

if ! command -v bd >/dev/null 2>&1; then
  run_step "Install the Beads CLI" bash -c \
    'curl -fsSL https://raw.githubusercontent.com/gastownhall/beads/main/scripts/install.sh | bash'
fi

run_step "Install locked workspace dependencies" deno install --frozen

if ! command -v google-chrome >/dev/null 2>&1; then
  run_step "Install Chrome and browser runtime dependencies" \
    deno run -A npm:playwright@1.62.1 install --with-deps chrome
fi

printf '\nOrb setup complete.\n'
