{
  "name": "molgpu",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test packages/table/test/*.test.mjs packages/select/test/*.test.mjs packages/fields/test/*.test.mjs packages/io/test/*.test.mjs packages/geo/test/*.test.mjs packages/timeline/test/*.test.mjs packages/viewer/test/*.test.mjs",
    "test:fields:gpu": "node packages/fields/test/run-browser.mjs",
    "test:viewer:sizefield": "node packages/viewer/test/run-size-field.mjs",
    "test:viewer:gate2": "node packages/viewer/test/run-gate2.mjs",
    "test:corpus": "node --test packages/io/test/corpus.test.mjs",
    "test:gpu": "node packages/viewer/test/run-browser.mjs",
    "test:components": "node packages/viewer/test/run-components.mjs",
    "typecheck": "tsc -p packages/viewer/test/tsx/tsconfig.json",
    "test:examples": "node spikes/examples/test/run-browser.mjs",
    "build:io:measure": "vite build --config packages/io/vite.config.mjs"
  },
  "devDependencies": {
    "@use-gpu/core": "0.20.0",
    "@use-gpu/live": "0.20.0",
    "@use-gpu/shader": "0.20.0",
    "@use-gpu/webgpu": "0.20.0",
    "@use-gpu/wgsl": "0.20.0",
    "@use-gpu/workbench": "0.20.0",
    "@webgpu/types": "0.1.68",
    "molstar": "^5.11.0",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
