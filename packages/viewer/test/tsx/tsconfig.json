{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "types": ["@webgpu/types"]
  },
  "include": ["consumer.tsx", "diagnostics.ts"]
}
